    function renderWeeklyStrength() {
      const weekStart = getWeekStartStr();
      const users = activeContext === 'both' ? ['me', 'partner'] : [activeContext];
      const container = document.getElementById('strength-status-list');
      const allMusclesSet = new Set();

      container.innerHTML = users.map((uKey) => {
        const p = appState.profiles[uKey];
        const logs = appState.records.filter((r) => r.userId === uKey && r.type === 'strength' && r.date >= weekStart);
        const count = logs.length;
        logs.forEach((l) => (l.muscles || []).forEach((m) => allMusclesSet.add(`${p.name}:${m}`)));

        const reached = count >= 2;
        return `
          <div class="bg-slate-900/75 p-3 rounded-xl border border-slate-800/90 flex items-center justify-between">
            <div>
              <div class="text-xs font-bold ${uKey === 'me' ? 'text-sky-400' : 'text-rose-400'}">${p.name}</div>
