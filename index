          <path d="M130 265 L195 265 L225 185 L275 335 L310 245 L382 245" fill="none" stroke="url(#accent)" stroke-width="28" stroke-linecap="round" stroke-linejoin="round"/>
          <circle cx="365" cy="155" r="24" fill="#F43F5E"/>
        </svg>
      `.trim();

      const svgDataUrl = 'data:image/svg+xml;charset=utf-8,' + encodeURIComponent(svgIcon);

      const img = new Image();
      img.onload = function () {
        const canvas = document.createElement('canvas');
        canvas.width = 512;
        canvas.height = 512;
        const ctx = canvas.getContext('2d');
        ctx.drawImage(img, 0, 0, 512, 512);
        const pngDataUrl = canvas.toDataURL('image/png');
        document.getElementById('apple-touch-icon').href = pngDataUrl;
        document.getElementById('modal-icon-preview').src = pngDataUrl;

        const manifest = {
          name: 'SyncFit 情侶健康與體態追蹤',
          short_name: 'SyncFit健康',
          start_url: '.',
          display: 'standalone',
          background_color: '#070B14',
          theme_color: '#070B14',
          icons: [{ src: pngDataUrl, sizes: '512x512', type: 'image/png' }]
        };
        const manifestBlob = new Blob([JSON.stringify(manifest)], { type: 'application/json' });
        document.getElementById('app-manifest').href = URL.createObjectURL(manifestBlob);
      };
      img.src = svgDataUrl;
    }

    // ==================== 2. STATE, CLOUD SYNC & DEFAULT DATA ====================
    const ROOM_STORAGE_KEY = 'syncfit_couple_room_code_v1';
    const LOCAL_CACHE_KEY = 'syncfit_couple_health_chumi_weeki_v1';

    let db = null;
    let auth = null;
    let currentUser = null;
    let unsubscribeRoom = null;
    let isRemoteApplying = false;

    const DEFAULT_ROOM_CODE = 'Chumi0419weeki';

    function sanitizeRoomCode(raw) {
      const cleaned = (raw || '').trim().replace(/[^a-zA-Z0-9\-_]/g, '');
      return cleaned.length >= 4 ? cleaned : DEFAULT_ROOM_CODE;
    }

    function getInitialRoomCode() {
      const urlParams = new URLSearchParams(window.location.search);
      const paramRoom = urlParams.get('room');
      if (paramRoom && paramRoom.trim().length >= 4) {
        const clean = sanitizeRoomCode(paramRoom);
        localStorage.setItem(ROOM_STORAGE_KEY, clean);
        return clean;
      }
      const saved = localStorage.getItem(ROOM_STORAGE_KEY);
      if (saved && saved.trim().length >= 4) {
        return sanitizeRoomCode(saved);
      }
      return DEFAULT_ROOM_CODE;
    }

    let currentRoomCode = getInitialRoomCode();

    function getTodayStr(offsetDays = 0) {
      const d = new Date();
      d.setDate(d.getDate() + offsetDays);
      return d.toISOString().split('T')[0];
    }

    function getWeekStartStr() {
      const d = new Date();
      const day = d.getDay();
      const diff = d.getDate() - day + (day === 0 ? -6 : 1);
      const monday = new Date(d.setDate(diff));
      return monday.toISOString().split('T')[0];
    }

    function createDefaultState() {
      const today = getTodayStr(0);
      return {
        updatedAt: Date.now(),
        profiles: {
          me: {
            id: 'me',
            name: 'Chumi',
            gender: 'male',
            height: 175,
            weight: 71.5,
            waterMult: 35,
            proteinMult: 1.6,
            color: 'sky'
          },
          partner: {
            id: 'partner',
            name: 'Weeki',
            gender: 'female',
            height: 162,
            weight: 53.0,
            waterMult: 35,
            proteinMult: 1.6,
            color: 'rose'
          }
        },
        dailyIntake: {
          [`me_${today}`]: { water: 1250, protein: 65 },
          [`partner_${today}`]: { water: 1000, protein: 48 }
        },
        records: [
          { id: 'r1', userId: 'me', type: 'body', date: getTodayStr(-14), height: 175, weight: 72.8 },
          { id: 'r2', userId: 'me', type: 'body', date: getTodayStr(-7), height: 175, weight: 72.0 },
          { id: 'r3', userId: 'me', type: 'body', date: today, height: 175, weight: 71.5 },
          { id: 'r4', userId: 'partner', type: 'body', date: getTodayStr(-14), height: 162, weight: 53.8 },
          { id: 'r5', userId: 'partner', type: 'body', date: getTodayStr(-7), height: 162, weight: 53.4 },
          { id: 'r6', userId: 'partner', type: 'body', date: today, height: 162, weight: 53.0 },

          { id: 'r7', userId: 'me', type: 'cardio', date: getTodayStr(-2), subType: '慢跑 / 路跑', minutes: 45, note: '河濱公園慢跑' },
          { id: 'r8', userId: 'me', type: 'cardio', date: today, subType: '室內飛輪 / 單車', minutes: 50, note: '間歇心肺訓練' },
          { id: 'r9', userId: 'partner', type: 'cardio', date: getTodayStr(-1), subType: '快走 / 坡度健走', minutes: 60, note: '跑步機坡度10' },
          { id: 'r10', userId: 'partner', type: 'cardio', date: today, subType: '羽球 / 球類運動', minutes: 60, note: '雙人羽球對打' },

          { id: 'r11', userId: 'me', type: 'strength', date: getTodayStr(-2), muscles: ['背部', '手臂', '核心'], minutes: 60, note: '引體向上、划船' },
          { id: 'r12', userId: 'partner', type: 'strength', date: getTodayStr(-1), muscles: ['臀部', '腿部', '腹部'], minutes: 55, note: '深蹲、臀推' },

          { id: 'r13', userId: 'me', type: 'sleep', date: getTodayStr(-3), hours: 6.5, note: '稍微晚睡' },
          { id: 'r14', userId: 'me', type: 'sleep', date: getTodayStr(-2), hours: 7.5, note: '精神不錯' },
          { id: 'r15', userId: 'me', type: 'sleep', date: getTodayStr(-1), hours: 8.0, note: '深層睡眠充足' },
          { id: 'r16', userId: 'me', type: 'sleep', date: today, hours: 7.5, note: '準時起床' },

          { id: 'r17', userId: 'partner', type: 'sleep', date: getTodayStr(-3), hours: 7.5, note: '' },
          { id: 'r18', userId: 'partner', type: 'sleep', date: getTodayStr(-2), hours: 8.5, note: '睡得很香' },
          { id: 'r19', userId: 'partner', type: 'sleep', date: getTodayStr(-1), hours: 7.0, note: '' },
          { id: 'r20', userId: 'partner', type: 'sleep', date: today, hours: 8.0, note: '起床精神飽滿' }
        ]
      };
    }

    function loadLocalCache() {
      try {
        const raw = localStorage.getItem(LOCAL_CACHE_KEY);
        if (raw) return JSON.parse(raw);
      } catch (e) {
        console.warn('Cache load error:', e);
      }
      return createDefaultState();
    }

    let appState = loadLocalCache();

    function updateSyncStatusUI(status, detailText = '') {
      const dot = document.getElementById('sync-dot');
      const text = document.getElementById('sync-status-text');
      const modalDot = document.getElementById('modal-sync-dot');
      const modalTitle = document.getElementById('modal-sync-title');
      const modalDesc = document.getElementById('modal-sync-desc');

      if (!dot || !text) return;

      if (status === 'connected') {
        dot.className = 'w-2 h-2 rounded-full bg-emerald-400 shadow-[0_0_8px_#34d399]';
        text.textContent = `同步:${currentRoomCode}`;
        text.className = 'text-emerald-300 max-w-[84px] sm:max-w-[130px] truncate font-mono';
        if (modalDot) {
          modalDot.className = 'w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse';
          modalTitle.textContent = '已連線雲端即時同步';
          modalTitle.className = 'text-xs font-bold text-emerald-300';
          modalDesc.textContent = `目前配對碼：${currentRoomCode}`;
        }
      } else if (status === 'connecting') {
        dot.className = 'w-2 h-2 rounded-full bg-amber-400 animate-ping';
        text.textContent = '同步連線中...';
        text.className = 'text-amber-300 max-w-[84px] sm:max-w-[130px] truncate';
        if (modalDot) {
          modalDot.className = 'w-2.5 h-2.5 rounded-full bg-amber-400 animate-ping';
          modalTitle.textContent = '正在連線雲端資料庫...';
          modalTitle.className = 'text-xs font-bold text-amber-300';
          modalDesc.textContent = `嘗試連線配對碼：${currentRoomCode}`;
        }
      } else {
        dot.className = 'w-2 h-2 rounded-full bg-rose-400';
        text.textContent = '離線本機模式';
        text.className = 'text-rose-300 max-w-[84px] sm:max-w-[130px] truncate';
        if (modalDot) {
          modalDot.className = 'w-2.5 h-2.5 rounded-full bg-rose-400';
          modalTitle.textContent = '離線本機模式';
          modalTitle.className = 'text-xs font-bold text-rose-300';
          modalDesc.textContent = detailText || '目前暫存於本機裝置';
        }
      }
    }

    async function saveState() {
      appState.updatedAt = Date.now();
      try {
        localStorage.setItem(LOCAL_CACHE_KEY, JSON.stringify(appState));
      } catch (e) {
        console.warn('Local cache save error:', e);
      }

      if (!db || !currentUser || isRemoteApplying) return;

      try {
        const roomDocRef = doc(db, 'artifacts', appId, 'public', 'data', 'couple_rooms', currentRoomCode);
        await setDoc(roomDocRef, {
          updatedAt: appState.updatedAt,
          profilesJson: JSON.stringify(appState.profiles),
          dailyIntakeJson: JSON.stringify(appState.dailyIntake),
          recordsJson: JSON.stringify(appState.records)
        });
      } catch (err) {
        console.error('Cloud sync write failed:', err);
        updateSyncStatusUI('offline', '雲端寫入異常，已暫存本機');
      }
    }

    function subscribeToRoom(roomCode) {
      if (!db || !currentUser) return;
      if (unsubscribeRoom) {
        unsubscribeRoom();
        unsubscribeRoom = null;
      }

      currentRoomCode = sanitizeRoomCode(roomCode);
      localStorage.setItem(ROOM_STORAGE_KEY, currentRoomCode);
      const roomInput = document.getElementById('room-code-input');
      if (roomInput) roomInput.value = currentRoomCode;

      updateSyncStatusUI('connecting');

      const roomDocRef = doc(db, 'artifacts', appId, 'public', 'data', 'couple_rooms', currentRoomCode);

      unsubscribeRoom = onSnapshot(
        roomDocRef,
        async (snapshot) => {
          updateSyncStatusUI('connected');
          if (snapshot.exists()) {
            const data = snapshot.data();
            try {
              isRemoteApplying = true;
              const parsedProfiles = data.profilesJson ? JSON.parse(data.profilesJson) : null;
              const parsedIntake = data.dailyIntakeJson ? JSON.parse(data.dailyIntakeJson) : null;
              const parsedRecords = data.recordsJson ? JSON.parse(data.recordsJson) : null;

              if (parsedProfiles && parsedIntake && parsedRecords) {
                appState = {
                  updatedAt: data.updatedAt || Date.now(),
                  profiles: parsedProfiles,
                  dailyIntake: parsedIntake,
                  records: parsedRecords
                };
                localStorage.setItem(LOCAL_CACHE_KEY, JSON.stringify(appState));
                refreshAllUI();
              }
            } catch (parseErr) {
              console.error('Error parsing remote room state:', parseErr);
            } finally {
              isRemoteApplying = false;
            }
          } else {
            // Room does not exist yet in cloud: initialize it with current state
            await saveState();
          }
        },
        (error) => {
          console.error('Firestore onSnapshot error:', error);
          updateSyncStatusUI('offline', '雲端連線中斷，已切換為本機模式');
        }
      );
    }

    async function initCloudSync() {
      try {
        if (typeof __firebase_config === 'undefined' || !__firebase_config) {
          updateSyncStatusUI('offline', '未偵測到雲端設定，使用本機儲存');
          return;
        }
        const firebaseConfig = JSON.parse(__firebase_config);
        const app = initializeApp(firebaseConfig);
        auth = getAuth(app);
        db = getFirestore(app);

        if (typeof __initial_auth_token !== 'undefined' && __initial_auth_token) {
          await signInWithCustomToken(auth, __initial_auth_token);
        } else {
          await signInAnonymously(auth);
        }

        currentUser = auth.currentUser;
        if (currentUser) {
          subscribeToRoom(currentRoomCode);
        } else {
          updateSyncStatusUI('offline', '驗證未完成，使用本機儲存');
        }
      } catch (err) {
        console.error('Firebase init error:', err);
        updateSyncStatusUI('offline', '雲端初始化失敗，使用本機儲存');
      }
    }

