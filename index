<!DOCTYPE html>
<html lang="zh-Hant" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>SyncFit 情侶健康與體態追蹤</title>

  <!-- Mobile Home Screen / PWA Meta Tags -->
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content="SyncFit健康" />
  <meta name="theme-color" content="#070B14" />
  <link id="apple-touch-icon" rel="apple-touch-icon" href="" />
  <link id="app-manifest" rel="manifest" href="" />

  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Chart.js for Visualizations -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>
  <!-- Google Fonts: Noto Sans TC & JetBrains Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600;700&family=Noto+Sans+TC:wght@400;500;700;900&display=swap" rel="stylesheet" />

  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: {
            sans: ['"Microsoft JhengHei"', '"微軟正黑體"', '"Noto Sans TC"', 'sans-serif'],
            mono: ['"JetBrains Mono"', 'monospace'],
          },
          colors: {
            bgDeep: '#070B14',
            cardDark: '#0F172A',
            cardElevated: '#162036',
            techBlue: '#0EA5E9',
            techCyan: '#22D3EE',
            partnerPink: '#F43F5E',
          },
        },
      },
    };
  </script>

  <style>
    body {
      background-color: #070B14;
      color: #F1F5F9;
      font-family: "Microsoft JhengHei", "微軟正黑體", "Noto Sans TC", sans-serif;
      -webkit-tap-highlight-color: transparent;
      overflow-x: hidden;
    }

    /* Custom Scrollbar */
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: #070B14;
    }
    ::-webkit-scrollbar-thumb {
      background: #1E293B;
      border-radius: 9999px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #0EA5E9;
    }

    /* Glassmorphism & Glow Utilities */
    .glass-card {
      background: linear-gradient(145deg, rgba(15, 23, 42, 0.92), rgba(11, 18, 33, 0.96));
      border: 1px solid rgba(56, 189, 248, 0.14);
      box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.7);
      backdrop-filter: blur(12px);
    }

    .tech-glow {
      box-shadow: 0 0 20px rgba(14, 165, 233, 0.22);
    }

    .pink-glow {
      box-shadow: 0 0 20px rgba(244, 63, 94, 0.22);
    }

    /* Hide scrollbar for horizontal chips */
    .no-scrollbar::-webkit-scrollbar {
      display: none;
    }
    .no-scrollbar {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }

    /* Custom Range Slider */
    input[type="range"] {
      -webkit-appearance: none;
      background: transparent;
    }
    input[type="range"]::-webkit-slider-runnable-track {
      height: 6px;
      border-radius: 999px;
      background: #1E293B;
    }
    input[type="range"]::-webkit-slider-thumb {
      -webkit-appearance: none;
      height: 20px;
      width: 20px;
      border-radius: 50%;
      background: #0EA5E9;
      margin-top: -7px;
      box-shadow: 0 0 10px rgba(14, 165, 233, 0.8);
      cursor: pointer;
    }

    /* Date input dark theme icon fix */
    input[type="date"]::-webkit-calendar-picker-indicator {
      filter: invert(1) brightness(0.8);
      cursor: pointer;
    }
  </style>
</head>
<body class="min-h-screen pb-24 selection:bg-sky-500 selection:text-white">

  <!-- Toast Notification Banner (Replaces alert) -->
  <div id="toast-container" class="fixed top-4 left-1/2 -translate-x-1/2 z-50 pointer-events-none transition-all duration-300 opacity-0 -translate-y-4">
    <div id="toast-box" class="px-4 py-2.5 rounded-2xl bg-slate-900/95 border border-sky-500/40 text-slate-100 text-sm font-medium shadow-2xl flex items-center gap-2 backdrop-blur-md">
      <i data-lucide="check-circle-2" class="w-4 h-4 text-sky-400"></i>
      <span id="toast-message">已儲存紀錄</span>
    </div>
  </div>

  <!-- Top App Bar -->
  <header class="sticky top-0 z-30 bg-[#070B14]/85 backdrop-blur-xl border-b border-slate-800/80">
    <div class="max-w-5xl mx-auto px-4 py-3 flex items-center justify-between gap-2">
      <!-- Brand -->
      <div class="flex items-center gap-2.5">
        <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-sky-500 to-cyan-400 flex items-center justify-center shadow-lg shadow-sky-500/25">
          <i data-lucide="activity" class="w-5 h-5 text-slate-950 stroke-[2.5]"></i>
        </div>
        <div>
          <h1 class="text-base sm:text-lg font-bold tracking-tight text-white leading-tight flex items-center gap-1.5">
      <!-- Right Actions: Sync Room, User Switcher & PWA Install Guide -->
      <div class="flex items-center gap-1.5 sm:gap-2">
        <!-- Cloud Sync Status Button -->
        <button onclick="openSyncModal()" id="sync-status-btn" title="設定情侶即時同步配對碼" class="px-2.5 py-1.5 rounded-xl bg-slate-900 hover:bg-slate-800 border border-slate-700/80 text-xs font-medium flex items-center gap-1.5 transition-all">
          <span id="sync-dot" class="w-2 h-2 rounded-full bg-amber-400"></span>
          <span id="sync-status-text" class="text-slate-300 max-w-[84px] sm:max-w-[120px] truncate">連線中...</span>
        </button>

        <!-- Segmented User Switcher -->
        <div class="bg-slate-900/90 p-1 rounded-xl border border-slate-800 flex items-center text-xs font-bold">
          <button onclick="setActiveContext('both')" id="btn-ctx-both" class="px-2 sm:px-2.5 py-1.5 rounded-lg transition-all text-slate-400 hover:text-white">
            雙人總覽
          </button>
          <button onclick="setActiveContext('me')" id="btn-ctx-me" class="px-2 sm:px-2.5 py-1.5 rounded-lg transition-all flex items-center gap-1">
            <span class="w-2 h-2 rounded-full bg-sky-400"></span>
            <span id="nav-name-me">Chumi</span>
          </button>
          <button onclick="setActiveContext('partner')" id="btn-ctx-partner" class="px-2 sm:px-2.5 py-1.5 rounded-lg transition-all flex items-center gap-1">
            <span class="w-2 h-2 rounded-full bg-rose-400"></span>
            <span id="nav-name-partner">Weeki</span>
          </button>
        </div>

        <!-- Home Screen Install Button -->
        <button onclick="openPwaModal()" title="加入手機桌面 Icon" class="p-2 rounded-xl bg-slate-900 hover:bg-slate-800 border border-slate-700/80 text-sky-400 transition-colors flex items-center gap-1 text-xs font-medium">
          <i data-lucide="smartphone" class="w-4 h-4"></i>
          <span class="hidden md:inline">桌面圖示</span>
        </button>
      </div>
    </div>
  </header>

  <!-- Main Content Area -->
  <main class="max-w-5xl mx-auto px-4 pt-5 space-y-6">

    <!-- ==================== TAB 1: DASHBOARD (儀表板) ==================== -->
    <section id="view-dashboard" class="space-y-6">

      <!-- Context Banner & Quick Date -->
      <div class="flex flex-wrap items-center justify-between gap-2 bg-slate-900/50 border border-slate-800/80 rounded-2xl px-4 py-3">
        <div class="flex items-center gap-2.5">
          <span id="dashboard-badge" class="px-2.5 py-1 rounded-lg text-xs font-bold bg-sky-500/20 text-sky-300 border border-sky-500/30">雙人同步模式</span>
          <span class="text-xs sm:text-sm text-slate-300" id="dashboard-subtitle">檢視兩人的即時體態指標與本週運動進度</span>
        </div>
        <div class="text-xs font-mono text-slate-400 flex items-center gap-1.5">
          <i data-lucide="calendar" class="w-3.5 h-3.5 text-sky-400"></i>
          <span id="current-week-label">本週統計</span>
        </div>
      </div>

      <!-- SECTION 1: BMI & IDEAL WEIGHT CARDS (Dual or Single View) -->
      <div id="bmi-cards-container" class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <!-- Rendered dynamically by JS -->
      </div>

      <!-- SECTION 2: DAILY WATER & PROTEIN TARGETS -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <!-- Hydration Card -->
        <div class="glass-card rounded-2xl p-5 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-3">
              <div class="flex items-center gap-2">
                <div class="w-8 h-8 rounded-xl bg-cyan-500/15 border border-cyan-500/30 flex items-center justify-center text-cyan-400">
                  <i data-lucide="droplets" class="w-4 h-4"></i>
                </div>
                <div>
                  <h3 class="text-sm font-bold text-white">今日水份攝取目標</h3>
                  <p class="text-[11px] text-slate-400">依體重動態計算 (<span id="water-multiplier-label">35</span> ml/kg)</p>
                </div>
              </div>
              <select id="water-user-select" onchange="syncActionUser(this.value)" class="bg-slate-900 border border-slate-700 text-xs rounded-lg px-2 py-1 text-slate-200 focus:outline-none focus:border-sky-500">
                <option value="me">Chumi</option>
                <option value="partner">Weeki</option>
              </select>
            </div>

            <!-- Numbers -->
            <div class="flex items-baseline justify-between mt-2">
              <div>
                <span id="today-water-current" class="text-2xl sm:text-3xl font-bold font-mono text-cyan-400">0</span>
                <span class="text-xs text-slate-400 font-mono"> / <span id="today-water-target">2450</span> ml</span>
              </div>
              <span id="today-water-pct" class="text-sm font-mono font-bold text-cyan-300 bg-cyan-500/10 px-2.5 py-0.5 rounded-lg border border-cyan-500/20">0%</span>
            </div>

            <!-- Progress Bar -->
            <div class="w-full h-3 bg-slate-800/90 rounded-full overflow-hidden mt-3 p-0.5 border border-slate-700/50">
              <div id="today-water-bar" class="h-full rounded-full bg-gradient-to-r from-sky-500 to-cyan-300 transition-all duration-500" style="width: 0%"></div>
            </div>
          </div>

          <!-- Quick Add Buttons -->
          <div class="mt-4 pt-3 border-t border-slate-800/80 flex flex-wrap items-center gap-2">
            <button onclick="quickAddWater(250)" class="flex-1 py-2 px-2.5 rounded-xl bg-slate-800/90 hover:bg-cyan-500/20 hover:border-cyan-500/40 border border-slate-700 text-xs font-mono font-semibold text-cyan-300 transition-all active:scale-95">
              +250ml
            </button>
            <button onclick="quickAddWater(500)" class="flex-1 py-2 px-2.5 rounded-xl bg-slate-800/90 hover:bg-cyan-500/20 hover:border-cyan-500/40 border border-slate-700 text-xs font-mono font-semibold text-cyan-300 transition-all active:scale-95">
              +500ml
            </button>
            <div class="flex items-center gap-1 flex-1 min-w-[110px]">
              <input type="number" id="custom-water-input" placeholder="自訂ml" class="w-full bg-slate-900 border border-slate-700 rounded-xl px-2.5 py-1.5 text-xs font-mono text-white focus:outline-none focus:border-cyan-400" />
              <button onclick="addCustomWater()" class="p-2 rounded-xl bg-cyan-500 text-slate-950 font-bold hover:bg-cyan-400 transition-colors">
                <i data-lucide="plus" class="w-3.5 h-3.5"></i>
              </button>
            </div>
          </div>
        </div>

        <!-- Protein Card -->
        <div class="glass-card rounded-2xl p-5 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-3">
              <div class="flex items-center gap-2">
                <div class="w-8 h-8 rounded-xl bg-sky-500/15 border border-sky-500/30 flex items-center justify-center text-sky-400">
                  <i data-lucide="beef" class="w-4 h-4"></i>
                </div>
                <div>
                  <h3 class="text-sm font-bold text-white">今日蛋白質攝取目標</h3>
                  <p class="text-[11px] text-slate-400">依體重動態計算 (<span id="protein-multiplier-label">1.6</span> g/kg)</p>
                </div>
              </div>
              <select id="protein-user-select" onchange="syncActionUser(this.value)" class="bg-slate-900 border border-slate-700 text-xs rounded-lg px-2 py-1 text-slate-200 focus:outline-none focus:border-sky-500">
                <option value="me">Chumi</option>
                <option value="partner">Weeki</option>
              </select>
            </div>

            <!-- Numbers -->
            <div class="flex items-baseline justify-between mt-2">
              <div>
                <span id="today-protein-current" class="text-2xl sm:text-3xl font-bold font-mono text-sky-400">0</span>
                <span class="text-xs text-slate-400 font-mono"> / <span id="today-protein-target">112</span> g</span>
              </div>
              <span id="today-protein-pct" class="text-sm font-mono font-bold text-sky-300 bg-sky-500/10 px-2.5 py-0.5 rounded-lg border border-sky-500/20">0%</span>
            </div>

            <!-- Progress Bar -->
            <div class="w-full h-3 bg-slate-800/90 rounded-full overflow-hidden mt-3 p-0.5 border border-slate-700/50">
              <div id="today-protein-bar" class="h-full rounded-full bg-gradient-to-r from-blue-600 to-sky-400 transition-all duration-500" style="width: 0%"></div>
            </div>
          </div>

          <!-- Quick Add Buttons -->
          <div class="mt-4 pt-3 border-t border-slate-800/80 flex flex-wrap items-center gap-2">
            <button onclick="quickAddProtein(15)" class="flex-1 py-2 px-2 rounded-xl bg-slate-800/90 hover:bg-sky-500/20 hover:border-sky-500/40 border border-slate-700 text-xs font-mono font-semibold text-sky-300 transition-all active:scale-95">
              +15g <span class="text-[10px] text-slate-400 font-sans">(蛋/豆漿)</span>
            </button>
            <button onclick="quickAddProtein(25)" class="flex-1 py-2 px-2 rounded-xl bg-slate-800/90 hover:bg-sky-500/20 hover:border-sky-500/40 border border-slate-700 text-xs font-mono font-semibold text-sky-300 transition-all active:scale-95">
              +25g <span class="text-[10px] text-slate-400 font-sans">(乳清/雞胸)</span>
            </button>
            <div class="flex items-center gap-1 flex-1 min-w-[105px]">
              <input type="number" id="custom-protein-input" placeholder="自訂g" class="w-full bg-slate-900 border border-slate-700 rounded-xl px-2.5 py-1.5 text-xs font-mono text-white focus:outline-none focus:border-sky-400" />
              <button onclick="addCustomProtein()" class="p-2 rounded-xl bg-sky-500 text-slate-950 font-bold hover:bg-sky-400 transition-colors">
                <i data-lucide="plus" class="w-3.5 h-3.5"></i>
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- SECTION 3: WEEKLY CARDIO (150-300 MINS), STRENGTH (2x/WK), & SLEEP (7-9 HRS) -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">

        <!-- Weekly Cardio 150-300 mins -->
        <div class="glass-card rounded-2xl p-5 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-2">
              <div class="flex items-center gap-2">
                <div class="w-8 h-8 rounded-xl bg-emerald-500/15 border border-emerald-500/30 flex items-center justify-center text-emerald-400">
                  <i data-lucide="heart-pulse" class="w-4 h-4"></i>
                </div>
                <div>
                  <h3 class="text-sm font-bold text-white">每週有氧運動</h3>
                  <p class="text-[11px] text-slate-400">WHO 建議 150～300 分鐘</p>
                </div>
              </div>
              <button onclick="switchTab('log', 'cardio')" class="text-xs px-2.5 py-1 rounded-lg bg-emerald-500/15 text-emerald-300 border border-emerald-500/30 hover:bg-emerald-500/25 transition-colors">
                + 紀錄
              </button>
            </div>

            <!-- Dual Partner or Single Breakdown -->
            <div id="cardio-status-list" class="space-y-4 mt-4">
              <!-- Populated by JS -->
            </div>
          </div>

          <div class="mt-4 pt-3 border-t border-slate-800/80 flex items-center justify-between text-[11px] text-slate-400">
            <span>150分：基礎健康達標</span>
            <span>300分：進階燃脂達標</span>
          </div>
        </div>

        <!-- Weekly Strength Training (2x/week) -->
        <div class="glass-card rounded-2xl p-5 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-2">
              <div class="flex items-center gap-2">
                <div class="w-8 h-8 rounded-xl bg-indigo-500/15 border border-indigo-500/30 flex items-center justify-center text-indigo-400">
                  <i data-lucide="dumbbell" class="w-4 h-4"></i>
                </div>
                <div>
                  <h3 class="text-sm font-bold text-white">每週肌力訓練</h3>
                  <p class="text-[11px] text-slate-400">目標每週至少 2 次</p>
                </div>
              </div>
              <button onclick="switchTab('log', 'strength')" class="text-xs px-2.5 py-1 rounded-lg bg-indigo-500/15 text-indigo-300 border border-indigo-500/30 hover:bg-indigo-500/25 transition-colors">
                + 紀錄
              </button>
            </div>

            <div id="strength-status-list" class="space-y-4 mt-4">
              <!-- Populated by JS -->
            </div>
          </div>

          <div class="mt-4 pt-3 border-t border-slate-800/80">
            <p class="text-[11px] text-slate-400 mb-1.5">本週已訓練肌群部位：</p>
            <div id="weekly-muscles-tags" class="flex flex-wrap gap-1.5">
              <!-- Populated by JS -->
            </div>
          </div>
        </div>

        <!-- Daily Sleep Tracker (7-9 hrs) -->
        <div class="glass-card rounded-2xl p-5 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-2">
              <div class="flex items-center gap-2">
                <div class="w-8 h-8 rounded-xl bg-violet-500/15 border border-violet-500/30 flex items-center justify-center text-violet-400">
                  <i data-lucide="moon-star" class="w-4 h-4"></i>
                </div>
                <div>
                  <h3 class="text-sm font-bold text-white">每日睡眠修復</h3>
                  <p class="text-[11px] text-slate-400">黃金標準 7～9 小時</p>
                </div>
              </div>
              <button onclick="switchTab('log', 'sleep')" class="text-xs px-2.5 py-1 rounded-lg bg-violet-500/15 text-violet-300 border border-violet-500/30 hover:bg-violet-500/25 transition-colors">
                + 紀錄
              </button>
            </div>

            <div id="sleep-status-list" class="space-y-4 mt-4">
              <!-- Populated by JS -->
            </div>
          </div>

          <div class="mt-4 pt-3 border-t border-slate-800/80 flex items-center justify-between text-[11px] text-slate-400">
            <span class="flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-amber-400"></span>&lt;7h 不足</span>
            <span class="flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-emerald-400"></span>7-9h 理想</span>
            <span class="flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-sky-400"></span>&gt;9h 過長</span>
          </div>
        </div>

      </div>

      <!-- SECTION 4: QUICK CHARTS PREVIEW -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="glass-card rounded-2xl p-5">
          <div class="flex items-center justify-between mb-3">
            <h3 class="text-sm font-bold text-white flex items-center gap-2">
              <i data-lucide="trending-down" class="w-4 h-4 text-sky-400"></i>
              體重變化趨勢 (kg)
            </h3>
            <span class="text-[11px] text-slate-400">近期紀錄</span>
          </div>
          <div class="h-52 w-full">
            <canvas id="dashboardWeightChart"></canvas>
          </div>
        </div>

        <div class="glass-card rounded-2xl p-5">
          <div class="flex items-center justify-between mb-3">
            <h3 class="text-sm font-bold text-white flex items-center gap-2">
              <i data-lucide="bar-chart-3" class="w-4 h-4 text-violet-400"></i>
              近 7 日睡眠時數對比 (小時)
            </h3>
            <span class="text-[11px] text-slate-400">目標 7-9h</span>
          </div>
          <div class="h-52 w-full">
            <canvas id="dashboardSleepChart"></canvas>
          </div>
        </div>
      </div>

    </section>

    <!-- ==================== TAB 2: QUICK LOGGING (新增紀錄) ==================== -->
    <section id="view-log" class="hidden space-y-5">
      <div class="glass-card rounded-2xl p-5 sm:p-6">
        <div class="flex flex-wrap items-center justify-between gap-3 pb-4 border-b border-slate-800">
          <div>
            <h2 class="text-lg font-bold text-white flex items-center gap-2">
              <i data-lucide="plus-circle" class="w-5 h-5 text-sky-400"></i>
              新增健康與運動紀錄
            </h2>
            <p class="text-xs text-slate-400 mt-0.5">選擇記錄對象與項目，資料將即時同步至統計報表</p>
          </div>

          <!-- Select Who is logging -->
          <div class="flex items-center gap-2 bg-slate-950 p-1.5 rounded-xl border border-slate-800">
            <span class="text-xs text-slate-400 pl-2">紀錄對象：</span>
            <button type="button" onclick="setLogFormUser('me')" id="form-user-me" class="px-3 py-1.5 rounded-lg text-xs font-bold transition-all bg-sky-500 text-slate-950">
              Chumi
            </button>
            <button type="button" onclick="setLogFormUser('partner')" id="form-user-partner" class="px-3 py-1.5 rounded-lg text-xs font-bold transition-all text-slate-400 hover:text-white">
              Weeki
            </button>
          </div>
        </div>

        <!-- Category Sub-tabs -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 my-4">
