    function runCompoundQuery() {
      const fUserSel = document.getElementById('filter-user');
      fUserSel.options[0].text = `全部人員 (${appState.profiles.me.name} + ${appState.profiles.partner.name})`;
      fUserSel.options[1].text = `僅限：${appState.profiles.me.name}`;
      fUserSel.options[2].text = `僅限：${appState.profiles.partner.name}`;

      const fUser = fUserSel.value;
      const fType = document.getElementById('filter-type').value;
      const fRange = document.getElementById('filter-range').value;
      const fMuscle = document.getElementById('filter-muscle').value;

      let startDate = '1970-01-01';
      let endDate = '2999-12-31';

      if (fRange === 'week') {
        startDate = getWeekStartStr();
      } else if (fRange === 'month') {
        startDate = getTodayStr(-30);
      } else if (fRange === 'custom') {
        startDate = document.getElementById('filter-start-date').value || '1970-01-01';
        endDate = document.getElementById('filter-end-date').value || '2999-12-31';
      }

      const filtered = appState.records
        .filter((r) => {
          if (fUser !== 'all' && r.userId !== fUser) return false;
          if (fType !== 'all' && r.type !== fType) return false;
          if (r.date < startDate || r.date > endDate) return false;
          if (fMuscle !== 'all') {
            if (r.type !== 'strength') return false;
            if (!r.muscles || !r.muscles.includes(fMuscle)) return false;
          }
          return true;
        })
        .sort((a, b) => b.date.localeCompare(a.date));

      // Compute KPIs
      const cardioMins = filtered
        .filter((r) => r.type === 'cardio')
        .reduce((sum, r) => sum + Number(r.minutes || 0), 0);

      const strengthLogs = filtered.filter((r) => r.type === 'strength');
      const sleepLogs = filtered.filter((r) => r.type === 'sleep');
      const avgSleep = sleepLogs.length
        ? (sleepLogs.reduce((sum, r) => sum + Number(r.hours || 0), 0) / sleepLogs.length).toFixed(1)
        : '--';

      document.getElementById('stat-count').textContent = `${filtered.length} 筆`;
      document.getElementById('stat-cardio').textContent = `${cardioMins} 分鐘`;
      document.getElementById('stat-strength').textContent = `${strengthLogs.length} 次`;
      document.getElementById('stat-sleep').textContent = avgSleep === '--' ? '-- 小時' : `${avgSleep} 小時`;

      // Render Muscle Distribution Chart
      const allMuscleNames = ['背部', '肩膀', '手臂', '腹部', '臀部', '腿部', '核心'];
      const muscleCounts = allMuscleNames.map((mName) =>
        strengthLogs.filter((l) => (l.muscles || []).includes(mName)).length
      );

      const mCtx = document.getElementById('queryMuscleChart').getContext('2d');
      if (muscleChartInstance) muscleChartInstance.destroy();
      muscleChartInstance = new Chart(mCtx, {
        type: 'doughnut',
        data: {
          labels: allMuscleNames,
          datasets: [{
            data: muscleCounts,
            backgroundColor: [
              '#0EA5E9', '#38BDF8', '#818CF8', '#A78BFA', '#F43F5E', '#34D399', '#FBBF24'
            ],
            borderColor: '#0F172A',
            borderWidth: 2
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: {
              position: 'right',
              labels: { color: '#CBD5E1', font: { size: 11 }, boxWidth: 12 }
            }
          }
        }
      });

      // Render Records Feed
      const listEl = document.getElementById('query-records-list');
      if (filtered.length === 0) {
        listEl.innerHTML = `
          <div class="text-center py-10 text-slate-500 text-sm">
            沒有符合目前複合篩選條件的紀錄，請嘗試放寬條件或新增紀錄。
          </div>
        `;
        return;
      }

      listEl.innerHTML = filtered.map((r) => {
        const who = appState.profiles[r.userId];
        const whoBadge = r.userId === 'me'
          ? 'bg-sky-500/20 text-sky-300 border-sky-500/30'
          : 'bg-rose-500/20 text-rose-300 border-rose-500/30';

        let contentHtml = '';
        if (r.type === 'body') {
          const bmi = calculateBMI(r.weight, r.height);
          contentHtml = `<span class="text-white font-semibold">體態紀錄</span> · 身高 ${r.height}cm / 體重 <span class="font-mono text-sky-300">${r.weight}kg</span> (BMI ${bmi})`;
        } else if (r.type === 'cardio') {
          contentHtml = `<span class="text-emerald-300 font-semibold">有氧運動 (${r.subType})</span> · <span class="font-mono text-white">${r.minutes} 分鐘</span> ${r.note ? `<span class="text-slate-400 text-xs">(${r.note})</span>` : ''}`;
        } else if (r.type === 'strength') {
          const mTags = (r.muscles || []).map((m) => `<span class="px-1.5 py-0.5 rounded bg-indigo-500/25 text-indigo-200 text-[11px]">${m}</span>`).join(' ');
          contentHtml = `<span class="text-indigo-300 font-semibold">肌力訓練</span> · ${mTags} ${r.note ? `<span class="text-slate-400 text-xs">(${r.note})</span>` : ''}`;
        } else if (r.type === 'sleep') {
          contentHtml = `<span class="text-violet-300 font-semibold">每日睡眠</span> · <span class="font-mono text-white">${r.hours} 小時</span> ${r.note ? `<span class="text-slate-400 text-xs">(${r.note})</span>` : ''}`;
        }

        return `
          <div class="p-3 rounded-xl bg-slate-900/90 border border-slate-800 flex items-center justify-between gap-2">
            <div class="space-y-1">
              <div class="flex items-center gap-2">
                <span class="px-2 py-0.5 rounded text-[11px] font-bold border ${whoBadge}">${who.name}</span>
                <span class="text-xs font-mono text-slate-400">${r.date}</span>
              </div>
              <div class="text-xs sm:text-sm text-slate-200">${contentHtml}</div>
            </div>
            <button onclick="deleteRecord('${r.id}')" title="刪除此筆紀錄" class="p-1.5 rounded-lg text-slate-500 hover:text-rose-400 hover:bg-rose-500/10 transition-colors">
              <i data-lucide="trash-2" class="w-4 h-4"></i>
            </button>
          </div>
        `;
      }).join('');

      lucide.createIcons();
    }

