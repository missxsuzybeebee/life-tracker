    // ==================== 4. HEALTH CALCULATION HELPERS ====================
    function calculateBMI(weightKg, heightCm) {
      if (!weightKg || !heightCm || heightCm <= 0) return 0;
      const hMeters = heightCm / 100;
      return +(weightKg / (hMeters * hMeters)).toFixed(1);
    }

    function getBMIStatus(bmi) {
      // Taiwan MOHW (衛福部) Adult BMI Standards: 18.5 ~ 23.9 Normal
      if (bmi < 18.5) {
        return {
          label: '體重過輕',
          badgeClass: 'bg-amber-500/20 text-amber-300 border-amber-500/40',
          barColor: '#FBBF24',
          advice: '建議適度增加優質蛋白質與肌力訓練'
        };
      } else if (bmi < 24.0) {
        return {
          label: '體重適中',
          badgeClass: 'bg-emerald-500/20 text-emerald-300 border-emerald-500/40',
          barColor: '#34D399',
          advice: '體態維持在理想健康區間，繼續保持！'
        };
      } else if (bmi < 27.0) {
        return {
          label: '體重過重',
          badgeClass: 'bg-orange-500/20 text-orange-300 border-orange-500/40',
          barColor: '#FB923C',
          advice: '建議每週累積 150-300 分鐘有氧並控制熱量'
        };
      } else {
        return {
          label: '輕度以上肥胖',
          badgeClass: 'bg-rose-500/20 text-rose-300 border-rose-500/40',
          barColor: '#F43F5E',
          advice: '建議循序漸進增加有氧運動與飲食調整'
        };
      }
    }

    function getIdealWeightRange(heightCm) {
      const hM = heightCm / 100;
      const minW = (18.5 * hM * hM).toFixed(1);
      const maxW = (23.9 * hM * hM).toFixed(1);
      return `${minW} ~ ${maxW} kg`;
    }

    function getDailyTargets(userKey) {
      const p = appState.profiles[userKey];
      const waterTarget = Math.round(p.weight * p.waterMult);
      const proteinTarget = Math.round(p.weight * p.proteinMult);
      return { waterTarget, proteinTarget };
    }

    function getTodayIntake(userKey) {
      const key = `${userKey}_${getTodayStr(0)}`;
      return appState.dailyIntake[key] || { water: 0, protein: 0 };
    }

