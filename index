      const bodyLogs = appState.records
        .filter((r) => r.type === 'body')
        .sort((a, b) => a.date.localeCompare(b.date));

      const uniqueDates = Array.from(new Set(bodyLogs.map((r) => r.date))).slice(-7);
      const meWeights = uniqueDates.map((d) => {
        const found = bodyLogs.filter((r) => r.userId === 'me' && r.date === d).pop();
        return found ? found.weight : null;
      });
      const partnerWeights = uniqueDates.map((d) => {
        const found = bodyLogs.filter((r) => r.userId === 'partner' && r.date === d).pop();
        return found ? found.weight : null;
      });

      const wCtx = document.getElementById('dashboardWeightChart').getContext('2d');
