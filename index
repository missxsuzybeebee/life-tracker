      refreshAllUI();
      showToast('已重置為預設範例資料');
    }

    // ==================== 12. PWA MODAL & INITIALIZATION ====================
    function openPwaModal() {
      const modal = document.getElementById('pwa-modal');
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      lucide.createIcons();
    }

    function closePwaModal() {
      const modal = document.getElementById('pwa-modal');
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }

    function refreshAllUI() {
      document.getElementById('nav-name-me').textContent = appState.profiles.me.name;
      document.getElementById('nav-name-partner').textContent = appState.profiles.partner.name;
      if (activeTab === 'dashboard') renderDashboard();
      if (activeTab === 'log') setLogFormUser(logFormUser);
      if (activeTab === 'query') runCompoundQuery();
      if (activeTab === 'profile') renderProfilePage();
    }

    // Expose functions to global window for inline HTML event handlers
    Object.assign(window, {
      setActiveContext,
      openSyncModal,
      closeSyncModal,
      handleJoinRoomSubmit,
      copyShareInvite,
      openPwaModal,
      closePwaModal,
      syncActionUser,
      quickAddWater,
      addCustomWater,
      quickAddProtein,
      addCustomProtein,
      switchTab,
      setLogFormUser,
      setLogCategory,
      updateLiveBmiPreview,
      submitBodyLog,
      submitCardioLog,
      clearMuscleSelection,
      submitStrengthLog,
      syncSleepInput,
      submitSleepLog,
      handleRangePresetChange,
      toggleMuscleFilterVisibility,
      resetFilters,
      runCompoundQuery,
      deleteRecord,
      selectProfileTab,
      saveProfileSettings,
      resetDemoData
    });

    // Boot Application
    window.addEventListener('DOMContentLoaded', () => {
      setupPwaAssets();
      document.getElementById('log-date').value = getTodayStr(0);
      document.getElementById('filter-start-date').value = getTodayStr(-7);
      document.getElementById('filter-end-date').value = getTodayStr(0);

      setActiveContext('both');
      setLogFormUser('me');
      setLogCategory('body');
      lucide.createIcons();
      initCloudSync();
    });
  </script>
</body>
</html>
